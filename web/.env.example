# Copy to .env (the server reads it at start-up; docker compose reads it too).

# HTTP port for both the device ingest (OsmAnd GET /?id=...) and the web UI.
PORT=5055

# Postgres. `pnpm db:up` starts one in Docker with exactly these credentials.
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker

# Owner's key. Signing in with it unlocks the "Access key" button in the
# dashboard, which rotates the shared viewer key without a deploy.
# Generate with: openssl rand -base64 18
ADMIN_KEY=

# Shared viewer key, used only to seed the database on the first start;
# afterwards the key lives in Postgres and is changed from the dashboard.
# Share as the key itself or as a link: https://your.host/#key=<the key>
ACCESS_KEY=

# Optional Google sign-in: an OAuth 2.0 "Web application" client ID from
# https://console.cloud.google.com/apis/credentials with the app's origin
# (http://localhost:5173 in dev, https://your.host in production) under
# "Authorised JavaScript origins". No client secret is needed.
GOOGLE_CLIENT_ID=

# Who may sign in with Google: comma-separated account e-mails. Empty = nobody.
ALLOWED_EMAILS=you@example.com

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Development only: skip Google and sign everyone in as dev@localhost.
AUTH_DISABLED=false

# A device is "online" while its last report is younger than this. The
# firmware sends a health report every 60 s (health_ms), so 150 s tolerates
# one lost report.
ONLINE_TIMEOUT_S=150

# Optional: only these device ids may report (comma-separated). Empty = any.
ALLOWED_DEVICE_IDS=
