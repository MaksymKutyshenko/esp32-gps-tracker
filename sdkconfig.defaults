# Project-wide ESP-IDF defaults applied when sdkconfig.<env> is generated.
# Delete the generated sdkconfig.<env> to re-apply after changing this file.
# Console: the IDF default (UART0 primary, USB Serial/JTAG secondary) suits
# the DevKitC; sdkconfig.defaults.supermini overrides it for the SuperMini.

# Task watchdog: on by default, 5 s, idle tasks watched. Application tasks
# subscribe themselves (esp_task_wdt_add) and feed it from their loops.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y

# Log lines carry the system clock (HH:MM:SS.mmm) instead of milliseconds
# since boot; the gps task sets the clock from the first GNSS fix, and it
# survives deep sleep. Before the first fix the clock reads 00:00:xx.
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Run-time statistics for the CPU-load figure the checklist asks for.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
